{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.8.0/schema.json",
  "name": "daily_trips",
  "position": {
    "x": 20,
    "y": 72,
    "z": 3000,
    "height": 300,
    "width": 760,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "DimDate.Date",
              "nativeQueryRef": "Date",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactDaily"
                    }
                  },
                  "Property": "Trips"
                }
              },
              "queryRef": "FactDaily.Trips",
              "nativeQueryRef": "Trips"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSegment"
                    }
                  },
                  "Property": "Segment"
                }
              },
              "queryRef": "DimSegment.Segment",
              "nativeQueryRef": "Segment"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Line chart of daily completed trips for the four segments'"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Completed trips per day by segment'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
