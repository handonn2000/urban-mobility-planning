table FactDaily
	lineageTag: dd375717-de3f-5193-8194-8fd72635c933

	measure Trips = SUM(FactDaily[TripCount])
		formatString: #,0
		lineageTag: 644f6adf-d432-5677-89d2-3c679792fb79

	measure 'Average fare' = DIVIDE(SUM(FactDaily[FareSum]), SUM(FactDaily[EconomicsTrips]))
		formatString: \$#,0.00
		lineageTag: 9c7e255a-78ef-544e-97cc-0c245e87afc3

	measure 'Platform share' = DIVIDE(SUM(FactDaily[FareSum]) - SUM(FactDaily[DriverPaySum]), SUM(FactDaily[FareSum]))
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: cf23698d-c76b-5aa9-b329-aec348292fcd

	measure 'Short trip share' = DIVIDE(SUM(FactDaily[ShortTrips]), [Trips])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: b06964f4-fa0e-5499-b40f-8a2add63f25f

	measure 'Low-fare trip share' = DIVIDE(SUM(FactDaily[LowFareTrips]), [Trips])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: da1e2dd0-e29e-5c85-b1d7-128f07c93b5f

	measure 'Median wait (one day and segment)' = IF(HASONEVALUE(DimDate[Date]) && HASONEVALUE(DimSegment[SegmentKey]), SELECTEDVALUE(FactDaily[MedianWait]))
		formatString: #,0.0
		lineageTag: c2866db0-0d43-5ca8-939a-abec4f15b578

	measure 'Trips same weekday last year' = CALCULATE([Trips], DATEADD(DimDate[Date], -364, DAY))
		formatString: #,0
		lineageTag: 120caae4-248b-573e-b8cd-7c14ace9a6c9

	measure 'Trips vs last year' = DIVIDE([Trips] - [Trips same weekday last year], [Trips same weekday last year])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 45ec1cc2-b6b0-574e-8791-7f5d78baa1e7

	column Date
		dataType: dateTime
		isHidden
		isAvailableInMdx: false
		formatString: yyyy-mm-dd
		lineageTag: 379af8cc-1230-59ea-b376-c52a516063ac
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column SegmentKey
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: e8f69228-7609-5833-8dcd-c173fd423bcf
		summarizeBy: none
		sourceColumn: SegmentKey

	column TripCount
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 7a71f472-5292-5657-a237-2f98e8930569
		summarizeBy: none
		sourceColumn: TripCount

	column ShortTrips
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: 0
		lineageTag: d14ba730-68de-53f1-bcd2-40d095df09b7
		summarizeBy: none
		sourceColumn: ShortTrips

	column LowFareTrips
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: 0
		lineageTag: e8f06e66-d15b-56d5-a7d6-881e3e55814a
		summarizeBy: none
		sourceColumn: LowFareTrips

	column EconomicsTrips
		dataType: int64
		isHidden
