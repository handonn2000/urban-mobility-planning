table FactWeeklyShare
	lineageTag: 9edee57e-a463-53f1-b65d-ccc065fc0f5b

	measure 'Lyft share' = DIVIDE(SUM(FactWeeklyShare[LyftTrips]), SUM(FactWeeklyShare[MarketTrips]))
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 275b4a2c-4a49-533a-843b-ced705017a2d

	column WeekStart
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 9513c73c-99cc-54a6-a1ab-4699698f216d
		summarizeBy: none
		sourceColumn: WeekStart

		annotation UnderlyingDateTimeDataType = Date

	column ZoneGroup
		dataType: string
		lineageTag: 1fd9e50d-beaf-5696-a034-16908d6a0a1c
		summarizeBy: none
		sourceColumn: ZoneGroup

	column LyftTrips
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: f8d15824-aee2-5a77-94bb-6fcc293db956
		summarizeBy: none
		sourceColumn: LyftTrips

	column MarketTrips
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 2cf301fe-9659-5adf-9c4b-f9e5ee3e4730
		summarizeBy: none
		sourceColumn: MarketTrips

	partition FactWeeklyShare = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"WeekStart", type date}, {"ZoneGroup", type text}, {"LyftTrips", Int64.Type}, {"MarketTrips", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
