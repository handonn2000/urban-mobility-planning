	partition FactAlertList = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"Segment", type text}, {"Trips", Int64.Type}, {"Expected", Int64.Type}, {"ZScore", Currency.Type}, {"Reason", type text}, {"ReferenceDays", type text}}, "en-US")
				in
