		lineageTag: b86e4b18-3553-51e7-b44b-af5914fa1b8e
		summarizeBy: none
		sourceColumn: FareSum

	column DriverPaySum
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 5769f31f-f40f-51c0-9c6c-f12c7f61b912
		summarizeBy: none
		sourceColumn: DriverPaySum

	column MedianWait
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: 0.0
		lineageTag: da06fa1b-b6b8-58d1-a58a-6be21aa4b6a6
		summarizeBy: none
		sourceColumn: MedianWait

	partition FactDaily = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"SegmentKey", type text}, {"TripCount", Int64.Type}, {"ShortTrips", Int64.Type}, {"LowFareTrips", Int64.Type}, {"EconomicsTrips", Int64.Type}, {"FareSum", type number}, {"DriverPaySum", type number}, {"MedianWait", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
