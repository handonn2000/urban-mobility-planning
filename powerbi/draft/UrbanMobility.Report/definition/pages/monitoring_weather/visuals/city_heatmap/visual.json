{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "city_heatmap",
  "position": {
    "x": 640,
    "y": 190,
    "width": 625,
    "height": 265,
    "z": 6,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "pivotTable",
    "query": {
      "queryState": {
        "Rows": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "DayName"
                }
              },
              "queryRef": "DimDate.DayName",
              "nativeQueryRef": "DayName"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimHour"
                    }
                  },
                  "Property": "Hour"
                }
              },
              "queryRef": "DimHour.Hour",
              "nativeQueryRef": "Hour"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactCityHourly"
                    }
                  },
                  "Property": "City average hourly trips"
                }
              },
              "queryRef": "FactCityHourly.City average hourly trips",
              "nativeQueryRef": "City average hourly trips"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'City-wide mean trips per weekday / hour'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
