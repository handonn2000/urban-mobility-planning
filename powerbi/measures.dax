Trips := SUM(FactDaily[Trips])

Trips prior weekday year :=
VAR ShiftedDates = SELECTCOLUMNS(VALUES(DimDate[Date]), "ShiftedDate", DimDate[Date] - 364)
VAR ExpectedDays = COUNTROWS(ShiftedDates)
VAR ObservedDays = CALCULATE(DISTINCTCOUNT(FactDaily[Date]), REMOVEFILTERS(DimDate), TREATAS(ShiftedDates, DimDate[Date]))
RETURN IF(ObservedDays = ExpectedDays, CALCULATE([Trips], REMOVEFILTERS(DimDate), TREATAS(ShiftedDates, DimDate[Date])))

Trips weekday year change :=
VAR PriorTrips = [Trips prior weekday year]
RETURN IF(NOT ISBLANK(PriorTrips), DIVIDE([Trips] - PriorTrips, PriorTrips))

Lyft share selected zones :=
VAR SelectedZones = VALUES(DimSegment[TouchesZone])
VAR MarketTrips = CALCULATE([Trips], REMOVEFILTERS(DimSegment), TREATAS(SelectedZones, DimSegment[TouchesZone]))
VAR LyftTrips = CALCULATE([Trips], REMOVEFILTERS(DimSegment), TREATAS(SelectedZones, DimSegment[TouchesZone]), DimSegment[Operator] = "Lyft")
RETURN DIVIDE(LyftTrips, MarketTrips)

Alert rows := COUNTROWS(FactAlerts)

Average base fare paired sample := DIVIDE(SUM(FactDaily[BaseFareSum]), SUM(FactDaily[ValidEconomicsTrips]))

City average hourly trips := AVERAGE(FactCityHourly[Trips])

City rainy hours := COUNTROWS(FILTER(FactCityHourly, FactCityHourly[RainMM] > 0))

City snow hours := COUNTROWS(FILTER(FactCityHourly, FactCityHourly[SnowCM] > 0))

Daily segment median wait := IF(HASONEVALUE(DimDate[Date]) && HASONEVALUE(DimSegment[SegmentKey]), SELECTEDVALUE(FactDaily[MedianWaitMinutes]))

Weekly Lyft share := DIVIDE(SUM(FactWeeklyShare[LyftTrips]), SUM(FactWeeklyShare[MarketTrips]))

Fee relative gap :=
VAR OperatorChoice = SELECTEDVALUE(DimFeeOperator[FeeOperator], "All")
RETURN CALCULATE(SELECTEDVALUE(FactFeeEffect[RelativeGrowthGap]), REMOVEFILTERS(DimFeeOperator), FactFeeEffect[FeeOperator] = OperatorChoice)

Fee all-trip gap := CALCULATE([Fee relative gap], REMOVEFILTERS(DimTripGroup), FactFeeEffect[TripGroup] = "all_trips")

Credit share gap pp := SELECTEDVALUE(FactCreditSummary[ShareGapPP])

Illustrative credit cost per extra trip := SELECTEDVALUE(FactCreditSummary[CostPerExtraTrip])

Planned trips B2 := SUM(FactPlan[B2])

Holiday scenario trips B3 := SUM(FactPlan[B3])

Forecast trips := IF(HASONEVALUE(DimMethod[Method]), SUM(FactForecast[ForecastTrips]))

Forecast actual trips := CALCULATE(SUM(FactForecast[ActualTrips]), REMOVEFILTERS(DimMethod), FactForecast[Method] = "B2")

Forecast WAPE := IF(HASONEVALUE(DimMethod[Method]), DIVIDE(SUM(FactForecast[AbsoluteErrorTrips]), SUM(FactForecast[ActualTrips])))

Forecast MAE := IF(HASONEVALUE(DimMethod[Method]), DIVIDE(SUM(FactForecast[AbsoluteErrorTrips]), COUNTROWS(FactForecast)))

Forecast bias := IF(HASONEVALUE(DimMethod[Method]), DIVIDE(SUM(FactForecast[SignedErrorTrips]), SUM(FactForecast[ActualTrips])))

Forecast B1 trips := CALCULATE(SUM(FactForecast[ForecastTrips]), REMOVEFILTERS(DimMethod), FactForecast[Method] = "B1")

Forecast B2 trips := CALCULATE(SUM(FactForecast[ForecastTrips]), REMOVEFILTERS(DimMethod), FactForecast[Method] = "B2")

Forecast B3 trips := CALCULATE(SUM(FactForecast[ForecastTrips]), REMOVEFILTERS(DimMethod), FactForecast[Method] = "B3")

Summer heavy rain trips factor := CALCULATE(SELECTEDVALUE(FactWeatherFactors[TripsFactor]), FactWeatherFactors[Study] = "summer_2024", FactWeatherFactors[WeatherGroup] = "moderate_or_heavy_rain")

Summer heavy rain wait factor := CALCULATE(SELECTEDVALUE(FactWeatherFactors[WaitFactor]), FactWeatherFactors[Study] = "summer_2024", FactWeatherFactors[WeatherGroup] = "moderate_or_heavy_rain")
