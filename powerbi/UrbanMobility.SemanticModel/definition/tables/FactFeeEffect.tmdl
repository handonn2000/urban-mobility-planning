table FactFeeEffect
	lineageTag: b3b4e43b-1d39-51f6-912b-d3650b2d2668

	measure 'Zone vs outside gap' = AVERAGE(FactFeeEffect[Gap])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: dc27d98d-5b5b-51f7-875f-d6c177b0a4a1

	column Operator
		dataType: string
		lineageTag: be52bb24-ba91-5783-9b72-ede22503a07d
		summarizeBy: none
		sourceColumn: Operator

	column TripGroup
		dataType: string
		lineageTag: fa8b31a0-23f9-523f-b84c-e62948daacbd
		summarizeBy: none
		sourceColumn: TripGroup
		sortByColumn: TripGroupOrder

	column TripGroupOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a6f5d7b8-56fd-5d5e-8a60-da8ebccd1e96
		summarizeBy: none
		sourceColumn: TripGroupOrder

	column Gap
		dataType: double
		isHidden
		isAvailableInMdx: false
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: 93733e58-b4e3-5241-b69e-f61642c991bb
		summarizeBy: none
		sourceColumn: Gap

	partition FactFeeEffect = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Operator", type text}, {"TripGroup", type text}, {"TripGroupOrder", Int64.Type}, {"Gap", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
