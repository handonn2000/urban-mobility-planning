table FactForecast
	lineageTag: 15b123da-370d-5f20-8f04-ae59a6dd4e96

	measure 'Actual trips' = CALCULATE(SUM(FactForecast[Actual]), DimMethod[Method] = "B2")
		formatString: #,0
		lineageTag: d10b4050-db99-54b7-ab36-4c4985bb2f7b

	measure 'Plan B2' = CALCULATE(SUM(FactForecast[Forecast]), DimMethod[Method] = "B2")
		formatString: #,0
		lineageTag: 9c6a79b9-7c63-5509-9852-4835fea6d9eb

	measure 'Plan vs actual' = DIVIDE([Plan B2] - [Actual trips], [Actual trips])
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: eb749b36-aca9-5568-b485-c4755956ece5

	measure WAPE = IF(HASONEVALUE(DimMethod[Method]), DIVIDE(SUMX(FactForecast, ABS(FactForecast[Forecast] - FactForecast[Actual])), SUM(FactForecast[Actual])))
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: dd2d5b83-4cc3-5ce6-ac1a-ada789b61eec

	measure Bias = IF(HASONEVALUE(DimMethod[Method]), DIVIDE(SUMX(FactForecast, FactForecast[Forecast] - FactForecast[Actual]), SUM(FactForecast[Actual])))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 031f7179-378b-5abb-980c-38acc996edb9

	measure 'WAPE B2' = CALCULATE([WAPE], DimMethod[Method] = "B2")
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: c15072d2-8ccf-508f-97e8-80df52fe0fe0

	column Date
		dataType: dateTime
