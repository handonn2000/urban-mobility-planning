table FactDaily
	lineageTag: dd375717-de3f-5193-8194-8fd72635c933

	measure Trips = SUM(FactDaily[TripCount])
		formatString: #,0
		lineageTag: 644f6adf-d432-5677-89d2-3c679792fb79

	column Date
		dataType: dateTime
		isHidden
		isAvailableInMdx: false
		formatString: yyyy-mm-dd
		lineageTag: 379af8cc-1230-59ea-b376-c52a516063ac
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column SegmentKey
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: e8f69228-7609-5833-8dcd-c173fd423bcf
		summarizeBy: none
		sourceColumn: SegmentKey

	column TripCount
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 7a71f472-5292-5657-a237-2f98e8930569
		summarizeBy: none
		sourceColumn: TripCount

	partition FactDaily = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"SegmentKey", type text}, {"TripCount", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
