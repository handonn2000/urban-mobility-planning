{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "daily_trips",
  "position": {
    "x": 15,
    "y": 190,
    "width": 610,
    "height": 265,
    "z": 5,
    "tabOrder": 5
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimDate"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "DimDate.Date",
              "nativeQueryRef": "Date"
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimSegment"
                    }
                  },
                  "Property": "SegmentLabel"
                }
              },
              "queryRef": "DimSegment.SegmentLabel",
              "nativeQueryRef": "SegmentLabel"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactDaily"
                    }
                  },
                  "Property": "Trips"
                }
              },
              "queryRef": "FactDaily.Trips",
              "nativeQueryRef": "Trips"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Completed trips by segment'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
