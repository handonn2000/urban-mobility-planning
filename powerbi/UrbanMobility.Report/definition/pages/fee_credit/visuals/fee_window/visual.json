{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.8.0/schema.json",
  "name": "fee_window",
  "position": {
    "x": 20,
    "y": 72,
    "z": 2000,
    "height": 300,
    "width": 400,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactFeeWindow"
                    }
                  },
                  "Property": "Bar"
                }
              },
              "queryRef": "FactFeeWindow.Bar",
              "nativeQueryRef": "Bar",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactFeeWindow"
                    }
                  },
                  "Property": "Zone trips"
                }
              },
              "queryRef": "FactFeeWindow.Zone trips",
              "nativeQueryRef": "Zone trips"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Column chart of zone trips in 2024, expected 2025 and actual 2025'"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Zone trips in 21 days vs the expected level'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
