		isHidden
		isAvailableInMdx: false
		lineageTag: c7643bf5-e047-5f19-b7fc-3be06ea6c099
		summarizeBy: none
		sourceColumn: Method

	column Forecast
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 83783496-343c-5983-8174-25e9688aecd5
		summarizeBy: none
		sourceColumn: Forecast

	column Actual
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 324b1698-8807-55cc-8aed-98bbf5e3044a
		summarizeBy: none
		sourceColumn: Actual

	partition FactForecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"SegmentKey", type text}, {"Method", type text}, {"Forecast", Currency.Type}, {"Actual", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
