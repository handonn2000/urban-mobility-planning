{
  "name": "UrbanMobility",
  "dataColors": [
    "#0F7B6C",
    "#D2632A",
    "#1B2430",
    "#7FC4B5",
    "#E9B98A",
    "#A7B0BA",
    "#4F9D8F",
    "#8C5A3C"
  ],
  "foreground": "#1F2933",
  "background": "#FFFFFF",
  "tableAccent": "#0F7B6C",
  "good": "#0F7B6C",
  "neutral": "#E9B98A",
  "bad": "#D2632A",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F2933"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5B6670"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F1EA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3DED2"
              }
            },
            "radius": 8
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F7B6C"
              }
            },
            "fontSize": 24
          }
        ],
        "accentBar": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0F7B6C"
              }
            },
            "width": 4
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B2430"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F4EE"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1F2933"
              }
            }
          }
        ]
      }
    }
