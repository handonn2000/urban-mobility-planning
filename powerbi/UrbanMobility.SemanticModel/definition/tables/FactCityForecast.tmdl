table FactCityForecast
	lineageTag: 74294520-ae13-5b2f-86be-a93381a0e73f

	measure 'City trips' = SUM(FactCityForecast[TripCount])
		formatString: #,0
		lineageTag: 404bdfd9-057e-5c85-a2dc-31314b870fa1

	measure 'City forecast' = SUM(FactCityForecast[Expected])
		formatString: #,0
		lineageTag: 96450518-25f5-5c44-8e8a-296285248831

	measure 'Band lower' = SUM(FactCityForecast[BandLower])
		formatString: #,0
		lineageTag: 409de3ec-feb4-5e07-88df-07b0750cbe3f

	measure 'Band upper' = SUM(FactCityForecast[BandUpper])
		formatString: #,0
		lineageTag: 08145e07-a2a2-521d-bac9-7f4abd0923a4

	column Date
		dataType: dateTime
		isHidden
		isAvailableInMdx: false
		formatString: yyyy-mm-dd
		lineageTag: 0f418feb-5be9-5058-aa05-b3ad14791b59
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column TripCount
		dataType: int64
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 61675960-2d00-5434-92c9-50319078ad53
		summarizeBy: none
		sourceColumn: TripCount

	column Expected
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 70a531c6-91a4-5fb4-9c3a-fcd0ab6dc6cf
		summarizeBy: none
		sourceColumn: Expected

	column BandLower
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: edcc6f8d-a8cb-5bf8-971d-58159adf7314
		summarizeBy: none
		sourceColumn: BandLower

	column BandUpper
		dataType: decimal
		isHidden
		isAvailableInMdx: false
		formatString: #,0
		lineageTag: 7499d418-b727-5d47-9fc1-bb6a8f1f9670
		summarizeBy: none
		sourceColumn: BandUpper

	partition FactCityForecast = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"Date", type date}, {"TripCount", Int64.Type}, {"Expected", Currency.Type}, {"BandLower", Currency.Type}, {"BandUpper", Currency.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
